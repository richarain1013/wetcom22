<Window x:Class="WeComLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="企业微信多账号启动器"
        Height="720" Width="980"
        MinHeight="600" MinWidth="860"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="180"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="企业微信多账号启动器" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="零注入 · 官方客户端 · 分批启动（建议 8–10 个）"
                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                 Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
    </DockPanel>

    <!-- Controls -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="WXWork 路径" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBox Grid.Column="1" Text="{Binding ExePath, UpdateSourceTrigger=PropertyChanged}"
                   Padding="8,6" VerticalContentAlignment="Center"/>
          <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseExeCommand}"/>
          <Button Grid.Column="3" Content="自动检测" Command="{Binding DetectExeCommand}"
                  Background="#344054"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
            <TextBlock Text="批量数量" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="48" Text="{Binding BatchCount}" Padding="6,4" TextAlignment="Center"/>
            <TextBlock Text="/ 10" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
            <TextBlock Text="启动间隔(ms)" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="64" Text="{Binding MinDelayMs}" Padding="6,4" TextAlignment="Center"/>
            <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center"/>
            <TextBox Width="64" Text="{Binding MaxDelayMs}" Padding="6,4" TextAlignment="Center"/>
          </StackPanel>
          <CheckBox Content="优先尝试注册表 multi_instances" IsChecked="{Binding PreferRegistry}"
                    VerticalAlignment="Center" Margin="0,0,0,8"/>
        </WrapPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Content="新开 1 个账号" Command="{Binding LaunchOneCommand}"/>
          <Button Content="分批启动" Command="{Binding LaunchBatchCommand}"/>
          <Button Content="取消批量" Command="{Binding CancelBatchCommand}" Background="#667085"/>
          <Button Content="刷新进程" Command="{Binding RefreshRunningCommand}" Background="#344054"/>
          <Button Content="全部关闭" Command="{Binding KillAllCommand}"
                  Background="{StaticResource DangerBrush}"/>
          <Button Content="保存设置" Command="{Binding PersistCommand}" Background="#344054"/>
          <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                     Foreground="{StaticResource MutedBrush}">
            <Run Text="运行中: "/><Run Text="{Binding RunningCount, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Slots -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,16">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="账号槽位（最多 10）" FontWeight="SemiBold" Margin="4,4,4,12"/>
        <ListView ItemsSource="{Binding Slots}" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}"/>
              <GridViewColumn Header="别名" Width="160">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" Padding="4"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="状态" Width="100" DisplayMemberBinding="{Binding Status}"/>
              <GridViewColumn Header="PID" Width="90" DisplayMemberBinding="{Binding Pid}"/>
              <GridViewColumn Header="启动时间" Width="160" DisplayMemberBinding="{Binding StartedAt}"/>
              <GridViewColumn Header="错误" Width="280" DisplayMemberBinding="{Binding LastError}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </Border>

    <!-- Logs -->
    <Border Grid.Row="3" Background="#0F172A" CornerRadius="10" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="运行日志" Foreground="#94A3B8" Margin="0,0,0,8"/>
        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                 Foreground="#E2E8F0" FontFamily="Consolas" FontSize="12"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
